{
  "name": "gmail-mcp",
  "version": "0.2.0",
  "description": "A local MCP server that connects multiple Gmail accounts to Claude (read-only, tokens in macOS Keychain)",
  "private": true,
  "license": "MIT",
  "author": "Sandeep K. Pandita",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/server.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "inspect": "npx @modelcontextprotocol/inspector npx tsx src/server.ts",
    "auth": "tsx src/auth.ts",
    "test": "node --import tsx --test --test-reporter=spec test/*.test.ts"
  },
  "dependencies": {
    "@googleapis/gmail": "^22.0.2",
    "@modelcontextprotocol/server": "^2.3.1",
    "@napi-rs/keyring": "^2.1.1",
    "google-auth-library": "^11.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
